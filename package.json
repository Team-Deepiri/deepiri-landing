{
  "name": "deepiri-landing",
  "version": "1.0.0",
  "description": "Deepiri Landing Page - Cloudflare Pages",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "dev:fast": "vite --host 0.0.0.0 --port 5174 --force",
    "dev:turbo": "vite --host 0.0.0.0 --port 5174 --force --clearScreen false",
    "dev:debug": "vite --host 0.0.0.0 --port 5174 --debug",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-checking": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^17.9.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.16"
  }
}
